{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug executable",
			"preLaunchTask": "clear terminal",
			"cargo": {
				"args": [
					"build",
					"--bin=rip",
					"--package=rip"
				],
				"filter": {
					"name": "rip",
					"kind": "bin"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}",
			"terminal": "integrated"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug unit tests in executable",
			"cargo": {
				"args": [
					"test",
					"--no-run",
					"--bin=rip",
					"--package=rip"
				],
				"filter": {
					"name": "rip",
					"kind": "bin"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}",
			"terminal": "integrated"
		}
	]
}